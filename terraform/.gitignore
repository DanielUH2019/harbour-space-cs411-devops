# Terraform state can contain sensitive values — never commit it.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local provider plugins / lock cache.
.terraform/
.terraform.lock.hcl

# Your real variable values (region, key path, IP allowlists).
terraform.tfvars
*.auto.tfvars

# Saved plans and crash logs.
*.tfplan
crash.log
crash.*.log

# Never let a key sneak in. deploy.pub is generated by the Jenkins Provision
# stage from the SSH credential; it should never be committed.
*.pem
deploy.pub
